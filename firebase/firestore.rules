rules_version = '2';

// Правила базы каталога номеров СоцГума.
// Публикуются вручную: Firebase → Firestore Database → Rules → вставить → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    // аккаунт — подтверждённый владелец страницы человека
    function owns(pid) {
      return signedIn()
        && exists(/databases/$(database)/documents/claims/$(pid))
        && get(/databases/$(database)/documents/claims/$(pid)).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/claims/$(pid)).data.status == 'approved';
    }

    // Лимиты в сутки и в месяц. Время считается по Самаре (UTC+4).
    // Счётчики лежат в usage/{аккаунт}_d{день} (комментарии, лайки) и usage/{аккаунт}_m{месяц} (фото, смена имени).
    function stamp() { return request.time + duration.value(4, 'h'); }
    function dayStamp() { return string(stamp().year()) + '-' + string(stamp().month()) + '-' + string(stamp().day()); }
    function monthStamp() { return string(stamp().year()) + '-' + string(stamp().month()); }
    function dayPath() { return /databases/$(database)/documents/usage/$(request.auth.uid + '_d' + dayStamp()); }
    function monthPath() { return /databases/$(database)/documents/usage/$(request.auth.uid + '_m' + monthStamp()); }
    function prevCount(p, f) { return exists(p) ? get(p).data.get(f, 0) : 0; }
    // имя автора: ник из кабинета, если он есть, иначе имя аккаунта
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function nickOf() { return exists(userPath()) ? get(userPath()).data.get('nick', '') : ''; }
    function nameFor(nick) { return nick != '' ? nick : request.auth.token.name; }
    function linkOk(v) { return v is string && v.size() <= 200 && (v == '' || v.matches('https?://[^ ]+')); }
    function authorOk(name) { return name == nameFor(nickOf()); }
    // комментарий считается за сегодняшний лимит: счётчик в той же записи вырос на 1, а номер за день входит в ключ
    function commentSlotOk(cid, cnt) {
      return cnt == prevCount(dayPath(), 'comments') + 1
        && cid == dayStamp() + '_' + request.auth.uid + '_' + string(cnt);
    }

    // Администраторы: запись только из консоли Firebase. Каждый видит только свою запись.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Список людей и номеров из таблицы. Обновляет администратор на странице «Кабинет».
    match /people/{pid} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /numbers/{nid} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /meta/{doc} {
      allow read, write: if isAdmin();
    }

    // Заявка «это моя страница». Всегда создаётся как ждущая, подтверждает администратор.
    match /claims/{pid} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'status', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/people/$(pid))
        && request.resource.data.status == 'pending';
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // Страница человека: описание, ссылка, фото. Правит подтверждённый владелец или администратор.
    match /profiles/{pid} {
      allow read: if true;
      allow create, update: if (owns(pid) || isAdmin())
        && request.resource.data.keys().hasOnly(['bio', 'link', 'avatar', 'updatedAt'])
        && request.resource.data.bio is string && request.resource.data.bio.size() <= 2000
        && request.resource.data.link is string && request.resource.data.link.size() <= 300
        && request.resource.data.avatar is string && request.resource.data.avatar.size() <= 150000
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    // Фото пользователя: маленькая картинка (128 px) для комментариев. Видна всем, меняет только владелец.
    match /users/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['avatar', 'nick', 'name', 'links', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && (!('avatar' in request.resource.data)
            || (request.resource.data.avatar is string && request.resource.data.avatar.size() <= 40000))
        && (!('nick' in request.resource.data)
            || (request.resource.data.nick is string && request.resource.data.nick.size() <= 40))
        && (!('name' in request.resource.data)
            || (request.resource.data.name is string && request.resource.data.name.size() <= 100))
        // ссылки на соцсети: ВКонтакте, Telegram, Instagram, YouTube, сайт; только http(s), до 200 знаков
        && (!('links' in request.resource.data)
            || (request.resource.data.links is map
                && request.resource.data.links.keys().hasOnly(['vk', 'tg', 'ig', 'yt', 'web'])
                && linkOk(request.resource.data.links.get('vk', ''))
                && linkOk(request.resource.data.links.get('tg', ''))
                && linkOk(request.resource.data.links.get('ig', ''))
                && linkOk(request.resource.data.links.get('yt', ''))
                && linkOk(request.resource.data.links.get('web', ''))))
        // новое фото: не больше 3 в месяц; новый ник: не больше 5 в месяц
        && (request.resource.data.get('avatar', '') == ''
            || request.resource.data.get('avatar', '') == (resource == null ? '' : resource.data.get('avatar', ''))
            || getAfter(monthPath()).data.get('avatars', 0) == prevCount(monthPath(), 'avatars') + 1)
        && (request.resource.data.get('nick', '') == (resource == null ? '' : resource.data.get('nick', ''))
            || getAfter(monthPath()).data.get('renames', 0) == prevCount(monthPath(), 'renames') + 1);
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    // Счётчики лимитов: растут не больше чем на 1 за запись и не выше предела.
    match /usage/{key} {
      function usePrev(f) { return resource == null ? 0 : resource.data.get(f, 0); }
      function useStep(f, max) {
        return request.resource.data.get(f, 0) >= usePrev(f)
          && request.resource.data.get(f, 0) <= usePrev(f) + 1
          && request.resource.data.get(f, 0) <= max;
      }
      allow read: if signedIn() && key.matches(request.auth.uid + '_.*');
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && ((key == request.auth.uid + '_d' + dayStamp()
              && request.resource.data.keys().hasOnly(['uid', 'comments', 'likes', 'updatedAt'])
              && useStep('comments', 10) && useStep('likes', 50))
            || (key == request.auth.uid + '_m' + monthStamp()
              && request.resource.data.keys().hasOnly(['uid', 'avatars', 'renames', 'updatedAt'])
              && useStep('avatars', 3) && useStep('renames', 5)));
      allow delete: if false;
    }

    // Слово постановщика на странице номера.
    match /notes/{nid} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['text', 'personId', 'updatedAt'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 3000
        && request.resource.data.updatedAt == request.time
        && (isAdmin()
            || (owns(request.resource.data.personId)
                && request.resource.data.personId in get(/databases/$(database)/documents/numbers/$(nid)).data.directors));
      allow delete: if isAdmin() || (resource.data.personId is string && owns(resource.data.personId));
    }

    // Комментарии. Читают все (скрытые видит администратор и автор), пишет любой вошедший.
    match /comments/{cid} {
      allow read: if resource.data.status == 'visible'
        || isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['numberId', 'uid', 'authorName', 'authorPersonId', 'text', 'createdAt', 'status', 'parentId'])
        && request.resource.data.uid == request.auth.uid
        && authorOk(request.resource.data.authorName)
        // не больше 10 комментариев в день: номер за день входит в ключ комментария
        && commentSlotOk(cid, getAfter(dayPath()).data.get('comments', 0))
        && request.resource.data.numberId is string && request.resource.data.numberId.size() <= 100
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 2000
        && request.resource.data.status == 'visible'
        && request.resource.data.createdAt == request.time
        && (!('parentId' in request.resource.data) || request.resource.data.parentId is string)
        && (!('authorPersonId' in request.resource.data) || owns(request.resource.data.authorPersonId));
      allow update: if (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        // счётчик лайков: меняется ровно на единицу и только вместе с записью лайка в том же пакете
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
          && ((resource.data.status == 'visible'
                && request.resource.data.likeCount == resource.data.get('likeCount', 0) + 1
                && !exists(/databases/$(database)/documents/likes/$(cid + '_' + request.auth.uid))
                && existsAfter(/databases/$(database)/documents/likes/$(cid + '_' + request.auth.uid)))
            || (request.resource.data.likeCount == resource.data.get('likeCount', 0) - 1
                && request.resource.data.likeCount >= 0
                && exists(/databases/$(database)/documents/likes/$(cid + '_' + request.auth.uid))
                && !existsAfter(/databases/$(database)/documents/likes/$(cid + '_' + request.auth.uid)))))
        // правка своего комментария: начать можно в первые 15 минут (записывается «окно» editUntil на несколько часов),
        // сохранить текст можно, пока идут 15 минут или открыто «окно»
        || (signedIn() && resource.data.uid == request.auth.uid && resource.data.status == 'visible'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['editUntil'])
          && request.time < resource.data.createdAt + duration.value(15, 'm')
          && request.resource.data.editUntil is timestamp
          && request.resource.data.editUntil <= request.time + duration.value(6, 'h'))
        || (signedIn() && resource.data.uid == request.auth.uid && resource.data.status == 'visible'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 2000
          && request.resource.data.editedAt == request.time
          && (request.time < resource.data.createdAt + duration.value(15, 'm')
              || ('editUntil' in resource.data && resource.data.editUntil > request.time)));
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // Обсуждаемое: счётчик комментариев по номерам. total — всего, wkn — неделя*10000 + число комментариев недели
    // (неделя идёт с понедельника, время Самары). Читают все. Обычный человек может изменить счётчик только на единицу
    // и только вместе с комментарием: добавленным (+1) или своим удаляемым (−1) в том же пакете. Администратор пишет любые значения
    // (кнопка «Пересчитать обсуждаемое» в кабинете).
    function weekOf(ts) { return math.floor((ts.toMillis() + 4 * 3600000 + 3 * 86400000) / 604800000); }
    function buzzCPath() { return /databases/$(database)/documents/comments/$(request.resource.data.ref); }
    function buzzAdded(nid) {
      return request.resource.data.ref is string
        && !exists(buzzCPath()) && existsAfter(buzzCPath())
        && getAfter(buzzCPath()).data.numberId == nid
        && getAfter(buzzCPath()).data.uid == request.auth.uid
        && getAfter(buzzCPath()).data.status == 'visible';
    }
    function buzzRemoved(nid) {
      return request.resource.data.ref is string
        && exists(buzzCPath()) && !existsAfter(buzzCPath())
        && get(buzzCPath()).data.numberId == nid
        && get(buzzCPath()).data.uid == request.auth.uid
        && get(buzzCPath()).data.status == 'visible';
    }
    match /buzz/{nid} {
      allow read: if true;
      allow create: if isAdmin()
        || (signedIn()
          && request.resource.data.keys().hasOnly(['total', 'wkn', 'ref'])
          && request.resource.data.total == 1
          && request.resource.data.wkn == math.floor((request.time.toMillis() + 4 * 3600000 + 3 * 86400000) / 604800000) * 10000 + 1
          && buzzAdded(nid));
      allow update: if isAdmin()
        || (signedIn()
          && request.resource.data.keys().hasOnly(['total', 'wkn', 'ref'])
          && ((request.resource.data.total == resource.data.total + 1
                && request.resource.data.wkn == (math.floor(resource.data.wkn / 10000) == math.floor((request.time.toMillis() + 4 * 3600000 + 3 * 86400000) / 604800000)
                    ? resource.data.wkn + 1
                    : math.floor((request.time.toMillis() + 4 * 3600000 + 3 * 86400000) / 604800000) * 10000 + 1)
                && buzzAdded(nid))
            || (request.resource.data.total == resource.data.total - 1
                && request.resource.data.total >= 0
                && request.resource.data.wkn == (math.floor(resource.data.wkn / 10000) == weekOf(get(buzzCPath()).data.createdAt)
                    ? resource.data.wkn - 1
                    : resource.data.wkn)
                && buzzRemoved(nid))));
      allow delete: if isAdmin();
    }

    // Оценки номера: 1–5 по четырём критериям (замысел, постановка, исполнение, сценическое воплощение)
    // и общему впечатлению. Один документ на человека и номер (ключ «номер_аккаунт»), все пять полей обязательны.
    // Читают все; создаёт и меняет только сам человек; убрать может он сам или администратор.
    function okScore(d, k) { return d[k] is int && d[k] >= 1 && d[k] <= 5; }
    match /ratings/{rid} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['numberId', 'uid', 'idea', 'comp', 'perf', 'stage', 'overall', 'updatedAt', 'ctx'])
        && request.resource.data.keys().hasAll(['numberId', 'uid', 'idea', 'comp', 'perf', 'stage', 'overall', 'updatedAt'])
        && request.resource.data.numberId is string && request.resource.data.numberId.size() <= 100
        && request.resource.data.uid == request.auth.uid
        && rid == request.resource.data.numberId + '_' + request.auth.uid
        && request.resource.data.updatedAt == request.time
        && okScore(request.resource.data, 'idea')
        && okScore(request.resource.data, 'comp')
        && okScore(request.resource.data, 'perf')
        && okScore(request.resource.data, 'stage')
        && okScore(request.resource.data, 'overall')
        && request.resource.data.get('ctx', 'team') in ['team', 'hall', 'absent'];
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Сводка оценок номера: rateAgg/{номер} = { n — число оценок, absent — «не был(а) на концерте», idea, comp, perf, stage, overall — суммы, ref }.
    // Страница читает один этот документ вместо всех оценок номера. Читают все. Обычный человек может изменить сводку
    // только на разницу между новой и прежней версией СВОЕЙ оценки в том же пакете (поле ref = «номер_аккаунт»):
    // правила сверяют итог с самими документами оценок. Создать сводку может администратор (кнопка пересчёта) или первая оценка номера.
    function raPath() { return /databases/$(database)/documents/ratings/$(request.resource.data.ref); }
    function raPrev(k) { return resource == null ? 0 : resource.data.get(k, 0); }
    function raOldV(k) { return exists(raPath()) ? get(raPath()).data[k] : 0; }
    function raNewV(k) { return existsAfter(raPath()) ? getAfter(raPath()).data[k] : 0; }
    function raStep(k) { return request.resource.data[k] == raPrev(k) + raNewV(k) - raOldV(k); }
    function raOldAbs() { return (exists(raPath()) && get(raPath()).data.get('ctx', 'team') == 'absent') ? 1 : 0; }
    function raNewAbs() { return (existsAfter(raPath()) && getAfter(raPath()).data.get('ctx', 'team') == 'absent') ? 1 : 0; }
    function raOk(nid) {
      return signedIn()
        && request.resource.data.keys().hasOnly(['n', 'absent', 'idea', 'comp', 'perf', 'stage', 'overall', 'ref'])
        && request.resource.data.keys().hasAll(['n', 'absent', 'idea', 'comp', 'perf', 'stage', 'overall', 'ref'])
        && request.resource.data.ref is string
        && request.resource.data.ref == nid + '_' + request.auth.uid
        && request.resource.data.n >= 0 && request.resource.data.absent >= 0
        && request.resource.data.n == raPrev('n') + (existsAfter(raPath()) ? 1 : 0) - (exists(raPath()) ? 1 : 0)
        && request.resource.data.absent == raPrev('absent') + raNewAbs() - raOldAbs()
        && raStep('idea') && raStep('comp') && raStep('perf') && raStep('stage') && raStep('overall');
    }
    match /rateAgg/{nid} {
      allow read: if true;
      allow create: if isAdmin() || (raOk(nid) && !exists(raPath()));
      allow update: if isAdmin() || raOk(nid);
      allow delete: if isAdmin();
    }

    // Плейлисты: список номеров с названием. Читают все, создаёт и меняет только владелец (до 200 номеров в списке).
    match /playlists/{pid} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'ownerName', 'name', 'numberIds', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.ownerName is string && request.resource.data.ownerName.size() <= 100
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 80
        && request.resource.data.numberIds is list && request.resource.data.numberIds.size() <= 200
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'ownerName', 'name', 'numberIds', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 80
        && request.resource.data.numberIds is list && request.resource.data.numberIds.size() <= 200
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Лайки комментариям. Один лайк на человека (ключ «комментарий_аккаунт»). Список лайкнувших публичный.
    // Убрать лайк может сам автор лайка, автор комментария (при удалении комментария) и администратор.
    function likeTargetOk(c) { return c.numberId == request.resource.data.numberId && c.status == 'visible'; }
    match /likes/{lid} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['commentId', 'numberId', 'uid', 'userName', 'createdAt'])
        && request.resource.data.commentId is string
        && lid == request.resource.data.commentId + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && authorOk(request.resource.data.userName)
        // не больше 50 лайков в день
        && getAfter(dayPath()).data.get('likes', 0) == prevCount(dayPath(), 'likes') + 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.numberId is string
        && exists(/databases/$(database)/documents/comments/$(request.resource.data.commentId))
        && likeTargetOk(get(/databases/$(database)/documents/comments/$(request.resource.data.commentId)).data);
      allow delete: if signedIn()
        && (resource.data.uid == request.auth.uid
            || isAdmin()
            || (exists(/databases/$(database)/documents/comments/$(resource.data.commentId))
                && get(/databases/$(database)/documents/comments/$(resource.data.commentId)).data.uid == request.auth.uid));
    }
  }
}
